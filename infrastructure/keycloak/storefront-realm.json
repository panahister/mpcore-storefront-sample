{
  "realm": "storefront",
  "displayName": "Storefront (development)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 1800,
  "roles": {
    "realm": [
      {
        "name": "customer",
        "description": "Shops: basket, checkout, own orders."
      },
      {
        "name": "catalog-manager",
        "description": "Lists, prices, restocks and withdraws products."
      },
      {
        "name": "support-agent",
        "description": "Reads every order, cancels any unshipped order, reads the audit trail."
      },
      {
        "name": "warehouse",
        "description": "The warehouse system: lists paid orders, reports shipments."
      },
      {
        "name": "analyst",
        "description": "Reads sales figures from the Analytics service."
      }
    ]
  },
  "clients": [
    {
      "clientId": "storefront-web",
      "name": "Storefront web shop (development)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "storefront-commerce-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "storefront-commerce-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "storefront-analytics-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "storefront-analytics-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "storefront-warehouse",
      "name": "Storefront warehouse system (development)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "lab-only-warehouse-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "storefront-commerce-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "storefront-commerce-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "storefront-fulfillment-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "storefront-fulfillment-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email",
        "service_account"
      ]
    },
    {
      "clientId": "storefront-edge",
      "name": "Storefront edge (Apache APISIX)",
      "description": "The gateway. It verifies the signature of a token with the realm's public keys; it signs nobody in and asks for no token.",
      "enabled": true,
      "publicClient": false,
      "secret": "lab-only-edge-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect"
    }
  ],
  "users": [
