{
  "name": "approve",
  "priority": 10,
  "request": {
    "method": "POST",
    "urlPath": "/demo-pay/v1/authorizations",
    "headers": {
      "Idempotency-Key": {
        "matches": ".+"
      },
      "X-Merchant-Id": {
        "equalTo": "STOREFRONT-01"
      }
    }
  },
  "response": {
    "status": 201,
    "headers": {
      "Content-Type": "application/json"
    },
    "transformers": [
      "response-template"
    ],
    "jsonBody": {
      "status": "APPROVED",
      "reference": "SPH-{{randomValue length=10 type='ALPHANUMERIC' uppercase=true}}",
      "orderId": "{{jsonPath request.body '$.orderId'}}"
    }
  }
}