# Copied to infrastructure/.env by scripts/up.sh. Development values for containers on this machine.
# Change a port here if it is taken on yours, then run scripts/setup.sh again.
COMPOSE_PROJECT_NAME=storefront

POSTGRES_USER=storefront
POSTGRES_PASSWORD=storefront
POSTGRES_PORT=45432
TIMESCALE_PORT=45433

KAFKA_PORT=49092
KAFKA_UI_PORT=48080

RABBITMQ_USER=storefront
RABBITMQ_PASSWORD=storefront
RABBITMQ_PORT=45672
RABBITMQ_UI_PORT=45673

REDIS_PORT=46379

KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=48180

WIREMOCK_PORT=48081

# off: the edge passes every request on. keycloak: the edge verifies tokens as well (docs/variations.md).
EDGE_AUTH=off
GATEWAY_HTTPS_PORT=49443
GATEWAY_HTTP_PORT=49080

OTLP_GRPC_PORT=44317
OTLP_HTTP_PORT=44318
PROMETHEUS_PORT=49090
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_PORT=43000
JAEGER_UI_PORT=46686
