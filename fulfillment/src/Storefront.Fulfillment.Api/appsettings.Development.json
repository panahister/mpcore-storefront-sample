{
  // Development settings for a developer's machine (README.md). Everything here points at a container on
  // this machine. Connection strings and the identity provider's address are deliberately NOT here:
  // scripts/setup.sh writes them to this project's user secrets, outside the repository.
  "Kestrel": {
    "Endpoints": {
      "Grpc": { "Url": "http://localhost:5201", "Protocols": "Http2" }
    }
  },
  "Security": {
    // The development Keycloak speaks plain HTTP. MP Core accepts that only in Development.
    "RequireHttpsMetadata": false,
    "Audiences": [ "storefront-fulfillment-api" ],
    "ClaimMapping": { "Preset": "Keycloak" }
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Messaging": {
    // Queues are declared at startup here; outside Development the platform owns them.
    "AutoProvision": true
  },
  "Observability": {
    "EnableOtlpExporter": true,
    "Logs": { "Exporter": "Otlp", "Endpoint": "http://localhost:44317", "Protocol": "Grpc" },
    "Metrics": { "Exporter": "Otlp", "Endpoint": "http://localhost:44317", "Protocol": "Grpc", "Prometheus": { "Enabled": false } },
    "Traces": { "Exporter": "Otlp", "Endpoint": "http://localhost:44317", "Protocol": "Grpc", "SamplingRatio": 1.0 }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Wolverine": "Information"
    }
  }
}
