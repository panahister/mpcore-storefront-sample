+
+    public async Task<IReadOnlyList<CancellationSales>> CancellationsAsync(
+        DateTimeOffset from, DateTimeOffset to, CancellationToken cancellationToken) =>
+        await database.Database.SqlQuery<CancellationSales>($"""
+            SELECT coalesce(reason, 'UNKNOWN') AS "Reason",
+                   count(*) AS "CancelledOrders"
+            FROM analytics.order_facts
+            WHERE kind = 'Cancelled' AND occurred_on_utc >= {from} AND occurred_on_utc < {to}
+            GROUP BY 1
+            ORDER BY "CancelledOrders" DESC, "Reason"
+            """).ToListAsync(cancellationToken).ConfigureAwait(false);
 }
